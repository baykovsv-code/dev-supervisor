{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development Supervisor host capability grants v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "capabilities"],
  "properties": {
    "version": {"const": 1},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self_modification", "user_requested_modification", "repository_push"],
      "properties": {
        "self_modification": {"type": "boolean"},
        "user_requested_modification": {"type": "boolean"},
        "repository_push": {"type": "boolean"}
      }
    }
  }
}
