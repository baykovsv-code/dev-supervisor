{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development Supervisor runtime state v7",
  "type": "object",
  "required": ["version", "phase", "current_ticket", "completed_tickets", "plan_epochs", "current_plan_epoch_id", "pending_push"],
  "properties": {
    "version": {"const": 7},
    "phase": {"type": "string"},
    "current_ticket": {"type": "string"},
    "completed_tickets": {"type": "array", "items": {"type": "string"}},
    "current_plan_epoch_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "plan_epochs": {"type": "array", "minItems": 1, "items": {"$ref": "plan-epoch-v1.schema.json"}},
    "audit_events": {"type": "array", "items": {"$ref": "audit-event-v1.schema.json"}},
    "engine_requirement": {"anyOf": [{"type": "null"}, {"$ref": "engine-binding-v2.schema.json#/$defs/identity"}]},
    "state_predecessor": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/predecessor"}]},
    "legacy_cutover": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/legacy_cutover"}]},
    "pending_push": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/pending_push"}]}
  },
  "$defs": {
    "predecessor": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "checksum", "archive"],
      "properties": {
        "version": {"const": 6},
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "archive": {"type": "string", "pattern": "^state-predecessors/[0-9a-f]{64}\\.json$"}
      }
    },
    "legacy_cutover": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "checksum", "archive"],
      "properties": {
        "version": {"const": 1},
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "archive": {"type": "string", "pattern": "^legacy-cutover-archives/[0-9a-f]{64}\\.json$"}
      }
    },
    "pending_push": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "target"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "target": {"type": "object"}
      }
    }
  }
}
