{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development Supervisor plan epoch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["epoch_id", "prior_epoch_id", "created_at", "plan_digest", "tickets", "completion"],
  "properties": {
    "epoch_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "prior_epoch_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tickets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "completion": {"type": ["object", "null"]}
  }
}
