{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development supervisor repair report",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "ticket", "status", "summary", "files_changed", "checks_run"],
  "properties": {
    "role": {"type": "string", "enum": ["supervisor_repair"]},
    "ticket": {
      "type": "string",
      "pattern": "^(?:T|F)[0-9]{2}(?:\\.[0-9]+)?$"
    },
    "status": {"type": "string", "enum": ["repaired", "blocked"]},
    "summary": {"type": "string", "pattern": ".+"},
    "files_changed": {
      "type": "array",
      "items": {"type": "string", "pattern": ".+"}
    },
    "checks_run": {
      "type": "array",
      "items": {"type": "string", "pattern": ".+"}
    }
  }
}
