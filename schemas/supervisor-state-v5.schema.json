{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development Supervisor runtime state v5",
  "type": "object",
  "required": ["version", "phase", "current_ticket", "completed_tickets", "plan_epochs", "current_plan_epoch_id"],
  "properties": {
    "version": {"const": 5},
    "phase": {"type": "string"},
    "current_ticket": {"type": "string"},
    "completed_tickets": {"type": "array", "items": {"type": "string"}},
    "current_plan_epoch_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "plan_epochs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/epoch"}
    }
  },
  "$defs": {
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch_id", "prior_epoch_id", "created_at", "plan_digest", "tickets", "completion"],
      "properties": {
        "epoch_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "prior_epoch_id": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"},
        "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tickets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "completion": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/completion"}]}
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "ticket", "run_id", "report", "verification_results", "reason"],
      "properties": {
        "commit": {"type": "string"},
        "ticket": {"type": "string"},
        "run_id": {"type": "string"},
        "report": {"type": "object"},
        "verification_results": {"type": "array"},
        "reason": {"type": "string"}
      }
    }
  }
}
