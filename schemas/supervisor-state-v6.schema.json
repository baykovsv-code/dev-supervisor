{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development Supervisor runtime state v6",
  "type": "object",
  "required": ["version", "phase", "current_ticket", "completed_tickets", "plan_epochs", "current_plan_epoch_id"],
  "properties": {
    "version": {"const": 6},
    "phase": {"type": "string"},
    "current_ticket": {"type": "string"},
    "completed_tickets": {"type": "array", "items": {"type": "string"}},
    "current_plan_epoch_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "plan_epochs": {"type": "array", "minItems": 1, "items": {"$ref": "plan-epoch-v1.schema.json"}},
    "audit_events": {"type": "array", "items": {"$ref": "audit-event-v1.schema.json"}},
    "state_predecessor": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/predecessor"}]},
    "improvement_audit": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "predecessor": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "checksum", "archive"],
      "properties": {
        "version": {"const": 5},
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "archive": {"type": "string", "pattern": "^state-predecessors/[0-9a-f]{64}\\.json$"}
      }
    }
  }
}
