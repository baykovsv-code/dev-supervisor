{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit improvement architecture impact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "request_digest", "parent_revision_digest", "content"],
  "properties": {
    "version": {"const": 1},
    "kind": {"const": "architecture_impact"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_revision_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["alternatives", "selected_design", "complexity_rationale", "architecture_delta", "risks"],
      "properties": {
        "alternatives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "selected_design": {"type": "string"},
        "complexity_rationale": {"type": "string"},
        "architecture_delta": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "risks": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
