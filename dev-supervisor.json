    "BACKLOG.md",
    "docs/architecture/",
    "dev-supervisor.json",
    "dev"
  ],
  "implementation_plan": "docs/architecture/implementation-plan.md",
  "initial_completed_tickets": [],
  "milestones": [
    {
      "after_ticket": "T12",
      "before_ticket": "T99",
      "message": "Qualification is complete. Do not release this gate under Supervisor 1.x; review cutover and activate one immutable Supervisor 2.0 controller generation.",
      "name": "Supervisor 2.0 cutover approval"
    }
  ],
  "model_watchdog": {
    "hard_timeout_seconds": 5400,
    "terminate_grace_seconds": 10,
    "warning_seconds": 2700
  },
  "models": {
    "architecture": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high"
    },
    "diagnostic": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high"
    },
    "implementation": {
      "model": "gpt-5.6-terra",
      "reasoning_effort": "medium"
    },
    "supervisor_repair": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high"
    }
  },
  "periodic_checkpoint": {
    "max_active_runtime_seconds": 7200,
    "max_completed_tickets": 2,
    "max_model_invocations": 3
  },
  "quota": {
    "architecture": {
      "five_hour_percent_left": 30,
      "weekly_percent_left": 20
    },
    "diagnostic": {
      "five_hour_percent_left": 30,
      "weekly_percent_left": 20
    },
    "implementation": {
      "five_hour_percent_left": 20,
      "weekly_percent_left": 15
    },
    "max_snapshot_age_minutes": 30,
