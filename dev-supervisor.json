    "max_history_entries": 80,
    "max_recent_runs": 4,
    "max_ticket_context_bytes": 24000
  },
  "evidence_check_commands": {},
  "expected_branch": "main",
  "forecast": {
    "minimum_history_samples": 2
  },
  "host_verification_capabilities": {},
  "human_evidence_gates": {},
