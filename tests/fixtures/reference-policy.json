  "host_verification_capabilities": {
    "loopback-bind-eperm": {
      "blocker_patterns": [
        "(?is)(?=.*(?:AF_INET|loopback|socket))(?=.*(?:EPERM|Operation not permitted|PermissionError))(?=.*(?:real-process|lifecycle|runtime))"
      ],
      "completion_summary_patterns": [
        "(?is)(?=.*(?:implementation|runtime))(?=.*(?:completed|complete|in place|provides))(?=.*(?:host|real-process))(?=.*(?:verification|checks?))"
      ],
      "required_report_check_patterns": [
        "(?is)runtime/tests",
        "(?is)passed",
        "(?is)git diff --check"
      ]
    },
    "pilot-a-loopback-bind-eperm": {
      "blocker_patterns": [
        "(?is)(?=.*(?:127\\.0\\.0\\.1|loopback|bind))(?=.*(?:EPERM|Operation not permitted|PermissionError))(?=.*(?:real-process|synthetic subprocess|rehearsal))"
      ],
      "completion_summary_patterns": [
        "(?is)(?=.*(?:completed|complete))(?=.*(?:host|real-process))(?=.*verification)"
      ],
      "required_report_check_patterns": [
        "(?is)test_runner\\.py",
        "(?is)passed",
        "(?is)py_compile"
      ]
    },
    "t13-loopback-bind-eperm": {
      "blocker_patterns": [
        "(?is)(?=.*(?:socket|loopback))(?=.*(?:EPERM|Operation not permitted|PermissionError))(?=.*real-process)(?=.*runtime)"
      ],
      "completion_summary_patterns": [
        "(?is)(?=.*T13)(?=.*repaired)(?=.*(?:checks? pass|checks? passed))(?=.*real-process)(?=.*verification)(?=.*(?:blocked|remains required))"
      ],
      "required_report_check_patterns": [
        "(?is)runtime/tests",
        "(?is)passed",
        "(?is)git diff --check"
      ]
    }
  },
